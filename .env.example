# Copy to .env and adjust before running Docker Compose.
# Real .env files are gitignored; only this template is committed.
#
# Each worktree/worker gets its own COMPOSE_PROJECT_NAME and port block per
# the convention in PLAN.md ("Worktree and merge protocol") and
# agents/ROSTER.md. Never point one worktree's services at another
# worktree's database or containers, and never run migrations or resets
# against a project name that is not your own.

# Compose isolation (defaults shown are the coordinator's "warehouse-main"
# block; other workers substitute their assigned project name and ports)
COMPOSE_PROJECT_NAME=warehouse-main

# Postgres (this worktree's isolated instance only)
POSTGRES_DB=warehouse
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=warehouse_dev_only
POSTGRES_PORT=5500

# Backend (G1's FastAPI app, agent/g1-api). FRONTEND_PORT is reserved;
# the frontend isn't wired into infra/compose.yaml yet, see docs/operations.md.
API_PORT=8100
FRONTEND_PORT=5200

# Provider credentials, read directly by backend/app/main.py. Leave blank
# for offline development: the backend runs standalone and honestly
# reports status=temporarily_unavailable / provider=missing rather than
# fabricating a response. Only the manual, credential-gated live-smoke
# workflow requires these; offline tests never do.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
